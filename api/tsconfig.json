{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "rootDir": "src",
    "outDir": ".conformance-build",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/conformance/**/*.ts"]
}
